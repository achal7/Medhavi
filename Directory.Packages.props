<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core Dependencies -->
    <PackageVersion Include="FSharp.Core" Version="10.1.201" />
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />

    <!-- UI -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageVersion Include="Bolero" Version="0.24.39" />
    <PackageVersion Include="Bolero.Server" Version="0.24.39" />
    <PackageVersion Include="Bolero.Build" Version="0.24.39" />
    <PackageVersion Include="Radzen.Blazor" Version="11.2.6" />
    
    <!-- Testing Stack -->
    <PackageVersion Include="Expecto" Version="11.1.0" />
    <PackageVersion Include="Expecto.FsCheck" Version="11.1.0" />
    <PackageVersion Include="FsCheck" Version="3.3.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-preview.7.26381.103" />
    <PackageVersion Include="Unquote" Version="7.0.1" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>
</Project>
