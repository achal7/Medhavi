root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# -----------------------------------------
# F# settings (DDD + FP)
# -----------------------------------------
[*.{fs,fsi,fsx}]

# General style
fsharp_semicolon_at_end_of_line = false
fsharp_space_before_parameter = true
fsharp_space_before_lowercase_invocation = true
fsharp_space_before_uppercase_invocation = false
fsharp_space_before_class_constructor = false
fsharp_space_before_member = false
fsharp_space_before_colon = false
fsharp_align_function_signature_to_indentation = false

# Indentation and wrapping
#fsharp_multiline_bracket_style = aligned
fsharp_multiline_block_brackets_on_same_column = true
fsharp_record_multiline_formatter = character_width
fsharp_array_or_list_multiline_formatter = character_width
fsharp_keep_max_number_of_blank_lines = 1
fsharp_newline_between_type_definition_and_members = true
fsharp_keep_if_then_in_same_line = true

# Readability and functional flow
fsharp_prefer_pipeline_over_function_application = true
fsharp_align_nested_match_braces = true
fsharp_alternative_long_member_definitions = false
fsharp_bar_before_discriminated_union_declaration = false

# Expression and binding widths (for pure function bodies)
fsharp_max_if_then_else_short_width = 50
fsharp_max_infix_operator_expression = 50
fsharp_max_value_binding_width = 80
fsharp_max_dot_get_expression_width = 50
fsharp_max_function_binding_width = 80

# Strict mode — off unless you want hardcore enforcement
fsharp_strict_mode = false

# Line endings and misc
end_of_line = unset

# -----------------------------------------
# Project / config files
# -----------------------------------------
[*.{xml,config,nuspec,props,targets,csproj,fsproj}]
indent_size = 2

[*.{json,md}]
indent_size = 2

[*.sh]
end_of_line = lf
