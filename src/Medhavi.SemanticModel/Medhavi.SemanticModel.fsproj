<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Semantic Error Algebra -->
    <Compile Include="SemanticErrors.fs" />

    <!-- Core Layer A primitives -->
    <Compile Include="Identities.fs" />
    <Compile Include="Timestamp.fs" />
    <Compile Include="Enums.fs" />
    <Compile Include="ValueObjects.fs" />

    <!-- Aggregate Root Shapes -->
    <Compile Include="ReferenceObjects.fs" />
    <Compile Include="ResourceNetwork.fs" />
    <Compile Include="Planning.fs" />
    <Compile Include="PlanningLifecycle.fs" />
    <Compile Include="EnterpriseFacts.fs" />
    <Compile Include="Obligation.fs" />
    <Compile Include="BomRisk.fs" />
    <Compile Include="Core.fs" />
    <Compile Include="PerformanceCatalog.fs" />

    <Compile Include="Invariants.fs" />
    <Compile Include="Lifecycles.fs" />
  </ItemGroup>
</Project>