<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Stores\Types.fs" />
    <Compile Include="Stores\ProjectionSubscription.fs" />
    <Compile Include="Stores\WorkspaceStore.fs" />
    <Compile Include="Stores\WorkspaceStoreRegistry.fs" />
    <Compile Include="Stores\DemandStore.fs" />
    <Compile Include="Stores\SupplyStore.fs" />
    <Compile Include="Stores\CapacityStore.fs" />
    <Compile Include="Stores\MaterialReservationStore.fs" />
    <Compile Include="Stores\StoreComposition.fs" />
    <Compile Include="Utility.fs" />
    <Compile Include="Components\ErrorBoundary.fs" />
    <Compile Include="Panels\RemoteData.fs" />
    <Compile Include="Panels\GridPanel.fs" />
    <Compile Include="Panels\DetailPanel.fs" />
    <Compile Include="Panels\ChartPanel.fs" />
    <Compile Include="Panels\SidebarPanel.fs" />
    <Compile Include="Panels\DemandPanel.fs" />
    <Compile Include="Workspaces\MaterialReservation.fs" />
    <Compile Include="Workspaces\MasterData.fs" />
    <Compile Include="Shells\Session.fs" />
    <Compile Include="Shells\LoginShell.fs" />
    <Compile Include="Shells\Appbar.fs" />
    <Compile Include="Shells\Navigation.fs" />
    <Compile Include="Shells\AppShell.fs" />
    <Compile Include="Shells\AppShellView.fs" />
    <Compile Include="Shells\WorkspaceEngine.fs" />
    <Compile Include="Shells\AppShellEngine.fs" />
    <Compile Include="Shells\SystemShell.fs" />
    <Compile Include="Services\AuthService.fs" />
    <Compile Include="Services\Registration.fs" />
    <Compile Include="Startup.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bolero" />
    <PackageReference Include="Bolero.Server" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medhavi.Common\Medhavi.Common.fsproj" />
    <ProjectReference Include="..\Medhavi.Contracts\Medhavi.Contracts.fsproj" />
    <ProjectReference Include="..\Medhavi.Nexus\Medhavi.Nexus.fsproj" />
    <ProjectReference Include="..\Medhavi.Web.Controls\Medhavi.Web.Controls.fsproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" />
  </ItemGroup>

</Project>
