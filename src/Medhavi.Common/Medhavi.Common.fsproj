<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Category Theory & Algebraic Structures -->
    <Compile Include="CategoryTheory.fs" />
    <Compile Include="Functor.fs" />
    <Compile Include="Applicative.fs" />
    <Compile Include="Optics.fs" />
    <Compile Include="Monad.fs" />
    <Compile Include="Comonad.fs" />

    <!-- Effect Algebras & State -->
    <Compile Include="StateMonad.fs" />
    <Compile Include="WriterMonad.fs" />
    <Compile Include="Result.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Codec.fs" />
    
    <!-- Asynchronous Effect Algebras -->
    <Compile Include="AsyncResult.fs" />
    <Compile Include="TaskResult.fs" />
    <Compile Include="AsyncValidator.fs" />
    
    <!-- Data Structures -->
    <Compile Include="FQueue.fs" />
    
    <!-- Global Computation Expressions -->
    <Compile Include="Global.fs" />
  </ItemGroup>

</Project>
