<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="IntegrationEvents.fs" />
    <Compile Include="Ingestion.fs" />
    <Compile Include="Adapters\SkuAdapter.fs" />
    <Compile Include="Adapters\BomAdapter.fs" />
    <Compile Include="Adapters\StockingPointAdapter.fs" />
    <Compile Include="Adapters\RoutingAdapter.fs" />
    <Compile Include="Adapters\TransportLegAdapter.fs" />
    <Compile Include="Adapters\PlantAdapter.fs" />
    <Compile Include="Adapters\UomAdapter.fs" />
    <Compile Include="Adapters\UnitConversionAdapter.fs" />
    <Compile Include="Adapters\InventoryTargetAdapter.fs" />
    <Compile Include="Adapters\SupplierOfferAdapter.fs" />
    <Compile Include="IntegrationService.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="csv\*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medhavi.Common\Medhavi.Common.fsproj" />
    <ProjectReference Include="..\Medhavi.Contracts\Medhavi.Contracts.fsproj" />
    <ProjectReference Include="..\Medhavi.SharedKernel\Medhavi.SharedKernel.fsproj" />
    <ProjectReference Include="..\Medhavi.Infrastructure\Medhavi.Infrastructure.fsproj" />
  </ItemGroup>

</Project>
