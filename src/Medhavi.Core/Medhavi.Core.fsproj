<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
  
    <Compile Include="ArsIdentifiers.fs" />
    <Compile Include="Helpers.fs" />
    
    <!-- Enterprise Picture Management (CA-C-019) -->
    <Compile Include="EnterprisePictureManagement\Model.fs" />
    <Compile Include="EnterprisePictureManagement\Policies.fs" />
    <Compile Include="EnterprisePictureManagement\Algorithms.fs" />
    <Compile Include="EnterprisePictureManagement\Rules.fs" />
    <Compile Include="EnterprisePictureManagement\Decisions.fs" />
    <Compile Include="EnterprisePictureManagement\Behaviors.fs" />
    <Compile Include="EnterprisePictureManagement\Projections.fs" />
    <Compile Include="EnterprisePictureManagement\ACL.fs" />
    <Compile Include="EnterprisePictureManagement\Capabilities.fs" />
    <Compile Include="EnterprisePictureManagement\Workflows.fs" />
    <Compile Include="EnterprisePictureManagement\Context.fs" />

    <!-- Core Exception Management (CA-C-020) -->
    <Compile Include="ExceptionManagement\Model.fs" />
    <Compile Include="ExceptionManagement\Policies.fs" />
    <Compile Include="ExceptionManagement\Rules.fs" />
    <Compile Include="ExceptionManagement\Decisions.fs" />
    <Compile Include="ExceptionManagement\Behaviors.fs" />
    <Compile Include="ExceptionManagement\Projections.fs" />
    <Compile Include="ExceptionManagement\ACL.fs" />
    <Compile Include="ExceptionManagement\Capabilities.fs" />
    <Compile Include="ExceptionManagement\Workflows.fs" />
    <Compile Include="ExceptionManagement\Context.fs" />

    <!-- Core Item Transition Management (CA-C-021) -->
    <Compile Include="ItemTransitionManagement\Model.fs" />
    <Compile Include="ItemTransitionManagement\Policies.fs" />
    <Compile Include="ItemTransitionManagement\Rules.fs" />
    <Compile Include="ItemTransitionManagement\Decisions.fs" />
    <Compile Include="ItemTransitionManagement\Behaviors.fs" />
    <Compile Include="ItemTransitionManagement\Projections.fs" />
    <Compile Include="ItemTransitionManagement\ACL.fs" />
    <Compile Include="ItemTransitionManagement\Capabilities.fs" />
    <Compile Include="ItemTransitionManagement\Context.fs" />

    <!-- Demand Management (CA-C-022) -->
    <Compile Include="DemandManagement\Model.fs" />
    <Compile Include="DemandManagement\Policies.fs" />
    <Compile Include="DemandManagement\Rules.fs" />
    <Compile Include="DemandManagement\Decisions.fs" />
    <Compile Include="DemandManagement\Behaviors.fs" />
    <Compile Include="DemandManagement\ACL.fs" />
    <Compile Include="DemandManagement\Projections.fs" />
    <Compile Include="DemandManagement\Capabilities.fs" />
    <Compile Include="DemandManagement\Workflows.fs" />
    <Compile Include="DemandManagement\Context.fs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medhavi.Common\Medhavi.Common.fsproj" />
    <ProjectReference Include="..\Medhavi.Foundation\Medhavi.Foundation.fsproj" />
    <ProjectReference Include="..\Medhavi.SemanticModel\Medhavi.SemanticModel.fsproj" />
    <ProjectReference Include="..\Medhavi.Contracts\Medhavi.Contracts.fsproj" />
    <ProjectReference Include="..\Medhavi.SharedKernel\Medhavi.SharedKernel.fsproj" />
  </ItemGroup>
</Project>