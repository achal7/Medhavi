<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>

    <!-- MRP Domain -->
    <Compile Include="Mrp\Domain\Policies.fs" />
    <Compile Include="Mrp\Domain\Errors.fs" />
    <Compile Include="Mrp\Domain\Types.fs" />
    <Compile Include="Mrp\Domain\Pegging.fs" />
    <Compile Include="Mrp\Domain\MrpRunAggregate.fs" />
    <Compile Include="Mrp\Domain\Replan.fs" />
    
    <Compile Include="Mrp\Domain\Algorithms\BomExplosion.fs" />
    <Compile Include="Mrp\Domain\Algorithms\LotSizing.fs" />
    <Compile Include="Mrp\Domain\Algorithms\SafetyStock.fs" />
    <Compile Include="Mrp\Domain\Algorithms\Netting.fs" />
    <Compile Include="Mrp\Domain\Algorithms\ForecastConsumption.fs" />
    <Compile Include="Mrp\Domain\Algorithms\TimePhasedBuckets.fs" />

    <!-- Pipeline Infrastructure & Steps -->
    <Compile Include="Mrp\Application\Pipeline.fs" />
    <Compile Include="Mrp\Application\Steps\PreprocessStep.fs" />
    <Compile Include="Mrp\Application\Steps\NettingStep.fs" />
    <Compile Include="Mrp\Application\Steps\SupplyGenerationStep.fs" />
    <Compile Include="Mrp\Application\Steps\PeggingStep.fs" />
    <Compile Include="Mrp\Application\Steps\PostprocessStep.fs" />
    <Compile Include="Mrp\Application\MrpDependencies.fs" />
    <Compile Include="Mrp\Application\Orchestrator.fs" />
    <Compile Include="Mrp\Application\MrpService.fs" />
    <Compile Include="Mrp\Application\ReplanService.fs" />

    <!-- Planning Layer Domain -->
    <Compile Include="Planning\Domain\TimeBucket.fs" />
    <Compile Include="Planning\Domain\Keys.fs" />
    <Compile Include="Planning\Domain\InputFingerprint.fs" />
    <Compile Include="Planning\Domain\PlanResult.fs" />
    <Compile Include="Planning\Domain\PlanningSnapshot.fs" />
    <Compile Include="Planning\Domain\PlanningRun.fs" />
    <Compile Include="Planning\Domain\PlanVersion.fs" />

    <!-- Planning Layer Application -->
    <Compile Include="Planning\Application\SolverStrategy.fs" />
    <Compile Include="Planning\Application\PlanningSnapshotBuilder.fs" />
    <Compile Include="Planning\Application\PlanVersionStore.fs" />
    <Compile Include="Planning\Application\ScenarioReadinessValidator.fs" />
    <Compile Include="Planning\Application\ScenarioDiffService.fs" />
    <Compile Include="Planning\Application\PlanningOrchestrator.fs" />

    <!-- Solver Strategies -->
    <Compile Include="Mrp\Application\MrpSolverStrategy.fs" />

    <!-- Replenishment -->
    <Compile Include="Replenishment\Domain.fs" />
    <Compile Include="Replenishment\Application.fs" />

    <!-- Main Scheduler Entry -->
    <Compile Include="Engine.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medhavi.Common\Medhavi.Common.fsproj" />
    <ProjectReference Include="..\Medhavi.Contracts\Medhavi.Contracts.fsproj" />
    <ProjectReference Include="..\Medhavi.SharedKernel\Medhavi.SharedKernel.fsproj" />
    <ProjectReference Include="..\Medhavi.Infrastructure\Medhavi.Infrastructure.fsproj" />
    <ProjectReference Include="..\Medhavi.Demand\Medhavi.Demand.fsproj" />
  </ItemGroup>

</Project>
