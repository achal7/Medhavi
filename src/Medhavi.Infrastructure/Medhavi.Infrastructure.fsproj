<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stores\EnvelopeStore.fs" />
    <Compile Include="Stores\EnvelopeStoreMem.fs" />
    <Compile Include="Stores\IdempotencyStore.fs" />
    <Compile Include="Projections.fs" />
    <Compile Include="IO.fs" />
    <Compile Include="Observation\MailboxLogger.fs" />
    <Compile Include="Observation\LoggerAdapter.fs" />
    <Compile Include="Observation\IngestionLogger.fs" />
    <Compile Include="Observation\ConsoleLogger.fs" />
    <Compile Include="Observation\TelemetryPublisher.fs" />
    <Compile Include="Observation\PerformanceTracker.fs" />
    <Compile Include="Observation\ActivityTrackingAdapter.fs" />
    <Compile Include="Observation\HealthCheckPublisher.fs" />
    <Compile Include="Observation\ObservationComposition.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Medhavi.Common\Medhavi.Common.fsproj" />
    <ProjectReference Include="..\Medhavi.Contracts\Medhavi.Contracts.fsproj" />
    <ProjectReference Include="..\Medhavi.SharedKernel\Medhavi.SharedKernel.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
