{
    "Server": {
        "Port": 5000,
        "LogMinimumLevel": "Information"
    },
    "Radzen": {
        "Theme": "Material"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Product": {
        "Name": "Medhavi",
        "EnvironmentLabel": "Dev"
    },
    "Adapters": {
        "Development": {
            "Enabled": true
        }
    },
    "Queries": {
        "MaximumRiskRows": 200
    },
    "AllowedHosts": "*"
}