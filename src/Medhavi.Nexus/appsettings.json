{
    "Server": {
        "Port": 5000,
        "LogMinimumLevel": "Information"
    },
    "Radzen": {
        "Theme": "Material"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "Console": {
            "Enabled": false
        },
        "File": {
            "Enabled": true,
            "Path": "logs/medhavi-nexus-{yyyyMMdd}.log",
            "MinimumLevel": "Information",
            "UseMailboxLogger": true,
            "BatchSize": 50,
            "FlushIntervalMs": 500
        }
    },
    "Telemetry": {
        "Console": {
            "Enabled": false
        },
        "File": {
            "Enabled": true,
            "Path": "logs/telemetry-{yyyyMMdd}.jsonl"
        },
        "MinimumSeverity": "Information",
        "BatchSize": 25,
        "FlushIntervalMs": 500
    },
    "Product": {
        "Name": "Medhavi",
        "EnvironmentLabel": "Dev"
    },
    "Adapters": {
        "Development": {
            "Enabled": true
        }
    },
    "Queries": {
        "MaximumRiskRows": 200
    },
    "AllowedHosts": "*"
}