{
    "Server": {
        "Port": 5000,
        "LogMinimumLevel": "Information"
    },
    "Radzen": {
        "Theme": "Material"
    },
    "DetailedErrors": true,
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.AspNetCore.SignalR": "Warning"
        },
        "Console": {
            "Enabled": false
        },
        "File": {
            "Enabled": true,
            "Path": "logs/medhavi-nexus-dev-{yyyyMMdd}.log",
            "MinimumLevel": "Debug",
            "UseMailboxLogger": true,
            "BatchSize": 10,
            "FlushIntervalMs": 200
        }
    },
    "Telemetry": {
        "Console": {
            "Enabled": false
        },
        "File": {
            "Enabled": true,
            "Path": "logs/telemetry-dev-{yyyyMMdd}.jsonl"
        },
        "MinimumSeverity": "Debug",
        "BatchSize": 10,
        "FlushIntervalMs": 200
    },
    "Product": {
        "Name": "Medhavi",
        "EnvironmentLabel": "Dev"
    },
    "Adapters": {
        "Development": {
            "Enabled": true
        }
    },
    "Queries": {
        "MaximumRiskRows": 200
    },
    "AllowedHosts": "*"
}